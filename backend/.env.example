# ============================================================
# HRConnect — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrconnect
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key_in_production
JWT_EXPIRES=8h

# Development only: exposes the local mock API and its sample data.
# Keep this unset in Railway/production.
ALLOW_MOCK_API=false

# Vynfy SMS OTP - used only for first-time HR account sign-up
VYNFY_API_KEY=
VYNFY_SENDER_ID=KenadHR
OTP_ENABLED=false

# Payroll rates (as decimals)
DEDUCTION_RATE=0.10
ALLOWANCE_RATE=0.05

# Attendance (hour at which clock-in is considered late, 24h)
LATE_THRESHOLD_HOUR=9

# Paystack billing (annual access plans)
# Keep the secret key on the server only. Set your public deployed URL for the
# Paystack return URL, and configure the same endpoint in Paystack Dashboard:
# https://your-domain.example/api/billing/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
PUBLIC_APP_URL=http://localhost:5000
# Amounts are in the smallest currency unit (pesewas for GHS). Replace these
# defaults with your own yearly prices before going live.
BILLING_PLANS=[{"key":"starter","name":"Starter","amount":120000,"description":"For small teams getting started with KenadHR."},{"key":"growth","name":"Growth","amount":300000,"description":"For growing teams that need the full HR workspace."},{"key":"business","name":"Business","amount":600000,"description":"For larger organisations with advanced HR needs."}]

# Web Push (generate once with: npx web-push generate-vapid-keys)
# Keep VAPID_PRIVATE_KEY on the server/Railway only. The public key is shared
# with browsers through the authenticated push status endpoint.
VAPID_SUBJECT=mailto:hello@aduseimedia.codes
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
